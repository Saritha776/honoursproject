; ==============================================================================
; Verdi nWave Signal Configuration File
; Project: NeuroEdge RISC-V SoC with Single GPIO VIP Transaction Flow
; Target: UVM Simulation Waveform (tb_neuroedge_uvm_top)
; Database: verification/sim/neuroedge_gpio_only_vip.fsdb
; ==============================================================================

viewPort 0 28 1600 900 380 120

signalSpacing 5
windowTimeUnit 1ps

; Initial view centered on the 7-pattern stimulus sequence (0 to 4 us)
zoom 0.000000 4000000.000000 1p
cursor 350000.000000
marker 3593070000.000000

curSTATUS ByChange

; ------------------------------------------------------------------------------
; Group 1: Clocks & Reset
; ------------------------------------------------------------------------------
addGroup "1. Clock & Reset"
addSignal -h 15 /tb_neuroedge_uvm_top/clk
addSignal -h 15 /tb_neuroedge_uvm_top/rst_n

; ------------------------------------------------------------------------------
; Group 2: GPIO VIP Interface (u_gpio_if)
; ------------------------------------------------------------------------------
addGroup "2. GPIO VIP Interface (u_gpio_if)"
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/u_gpio_if/gpio_in[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/u_gpio_if/gpio_out[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/u_gpio_if/gpio_dir[7:0]

; ------------------------------------------------------------------------------
; Group 3: DUT Top-Level GPIO Pins
; ------------------------------------------------------------------------------
addGroup "3. DUT GPIO Pins"
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/gpio_in[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/gpio_out[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/gpio_dir[7:0]

; ------------------------------------------------------------------------------
; Group 4: DUT GPIO Controller Internal Registers (u_gpio)
; ------------------------------------------------------------------------------
addGroup "4. GPIO Internal Registers (u_gpio)"
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/sync_ff1[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/sync_ff2[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/sync_ff2_prev[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/reg_gpio_out[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/reg_gpio_dir[7:0]
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/reg_gpio_flag
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/gpio_irq

; ------------------------------------------------------------------------------
; Group 5: Wishbone Bus to GPIO Controller
; ------------------------------------------------------------------------------
addGroup "5. Wishbone Bus (GPIO Slave)"
addSignal -h 15 /tb_neuroedge_uvm_top/dut/wb_gpio_cyc
addSignal -h 15 /tb_neuroedge_uvm_top/dut/wb_gpio_stb
addSignal -h 15 /tb_neuroedge_uvm_top/dut/wb_gpio_we
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/wb_gpio_adr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/wb_gpio_dat_w[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/wb_gpio_dat_r[31:0]
addSignal -h 15 /tb_neuroedge_uvm_top/dut/wb_gpio_ack

; ------------------------------------------------------------------------------
; Group 6: CPU Core Execution & Pipeline Trace
; ------------------------------------------------------------------------------
addGroup "6. CPU Execution & Trace"
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/cpu_trace_pc_o[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/cpu_trace_insn_o[31:0]
addSignal -h 15 /tb_neuroedge_uvm_top/dut/cpu_trace_valid_o
