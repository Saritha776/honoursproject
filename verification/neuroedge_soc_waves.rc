; ==============================================================================
; Verdi nWave Signal Configuration File
; Project: NeuroEdge RISC-V SoC with Systolic Array AI Accelerator
; Target: UVM Simulation Waveform (tb_neuroedge_soc)
; Radix: Addresses & Data = Hexadecimal | Systolic Results = 2's Complement Signed Decimal
; ==============================================================================

; Window Layout
viewPort 0 28 1280 720 340 120

; Signal spacing & time unit
signalSpacing 5
windowTimeUnit 1ps

; Waveform Viewport Range
zoom 0.000000 3350000.000000 1p
cursor 0.000000
marker 0.000000

curSTATUS ByChange

; ------------------------------------------------------------------------------
; Group 1: CPU Execution
; ------------------------------------------------------------------------------
addGroup "CPU Execution"
addSignal -h 15 /tb_neuroedge_soc/clk
addSignal -h 15 /tb_neuroedge_soc/rst_n
addSignal -h 15 /tb_neuroedge_soc/dut/cpu_trace_valid_o
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/cpu_trace_pc_o[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/cpu_trace_insn_o[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/gen_veer_cpu/u_cpu/trace_rv_i_valid_ip
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/gen_veer_cpu/u_cpu/trace_rv_i_address_ip[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/gen_veer_cpu/u_cpu/trace_rv_i_insn_ip[31:0]

; ------------------------------------------------------------------------------
; Group 2: AXI4
; ------------------------------------------------------------------------------
addGroup "AXI4"
addSignal -h 15 /tb_neuroedge_soc/dut/ifu_axi_arvalid
addSignal -h 15 /tb_neuroedge_soc/dut/ifu_axi_arready
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/ifu_axi_araddr[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/ifu_axi_rvalid
addSignal -h 15 /tb_neuroedge_soc/dut/ifu_axi_rready
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/ifu_axi_rdata[63:0]
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_awvalid
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_awready
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/lsu_axi_awaddr[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_wvalid
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_wready
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/lsu_axi_wdata[63:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/lsu_axi_wstrb[7:0]
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_bvalid
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_bready
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_arvalid
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_arready
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/lsu_axi_araddr[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_rvalid
addSignal -h 15 /tb_neuroedge_soc/dut/lsu_axi_rready
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/lsu_axi_rdata[63:0]

; ------------------------------------------------------------------------------
; Group 3: Wishbone
; ------------------------------------------------------------------------------
addGroup "Wishbone"
addSignal -h 15 /tb_neuroedge_soc/dut/u_interconnect/m0_wb_cyc_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_interconnect/m0_wb_stb_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_interconnect/m0_wb_we_i
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_interconnect/m0_wb_adr_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_interconnect/m0_wb_dat_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_interconnect/m0_wb_dat_o[31:0]
