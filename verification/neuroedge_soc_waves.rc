addSignal -h 15 /tb_neuroedge_soc/dut/u_interconnect/m0_wb_ack_o
addSignal -h 15 /tb_neuroedge_soc/dut/u_interconnect/m0_wb_err_o
addSignal -h 15 -UNSIGNED -BIN /tb_neuroedge_soc/dut/u_interconnect/grant[1:0]

; ------------------------------------------------------------------------------
