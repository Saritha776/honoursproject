; ------------------------------------------------------------------------------
addGroup "SRAM"
addSignal -h 15 /tb_neuroedge_soc/dut/u_isram/wb_cyc_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_isram/wb_stb_i
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_isram/wb_adr_i[31:0]
