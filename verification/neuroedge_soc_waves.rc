addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_dsram/a_wb_dat_o[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/u_dsram/a_wb_ack_o
addSignal -h 15 /tb_neuroedge_soc/dut/u_dsram/b_wb_cyc_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_dsram/b_wb_stb_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_dsram/b_wb_we_i
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_dsram/b_wb_adr_i[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/u_dsram/b_wb_ack_o

; ------------------------------------------------------------------------------
; Group 5: Systolic Array
; ------------------------------------------------------------------------------
addGroup "Systolic Array"
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/wb_cyc_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/wb_stb_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/wb_we_i
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_systolic_array/wb_adr_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_systolic_array/wb_dat_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_systolic_array/wb_dat_o[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/wb_ack_o
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/dma_act_valid
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_systolic_array/dma_act_data[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/dma_wgt_valid
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_systolic_array/dma_wgt_data[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/array_irq
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/reg_en
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/reg_start
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/reg_busy
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/reg_done
addSignal -h 15 /tb_neuroedge_soc/dut/u_systolic_array/reg_overflow
addSignal -h 15 -2COMP -DEC /tb_neuroedge_soc/dut/u_systolic_array/res_reg[0][31:0]
addSignal -h 15 -2COMP -DEC /tb_neuroedge_soc/dut/u_systolic_array/res_reg[1][31:0]
addSignal -h 15 -2COMP -DEC /tb_neuroedge_soc/dut/u_systolic_array/res_reg[2][31:0]
addSignal -h 15 -2COMP -DEC /tb_neuroedge_soc/dut/u_systolic_array/res_reg[3][31:0]

; ------------------------------------------------------------------------------
; Group 6: UART
; ------------------------------------------------------------------------------
addGroup "UART"
addSignal -h 15 /tb_neuroedge_soc/dut/u_uart/wb_cyc_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_uart/wb_stb_i
addSignal -h 15 /tb_neuroedge_soc/dut/u_uart/wb_we_i
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_uart/wb_adr_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_uart/wb_dat_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_soc/dut/u_uart/wb_dat_o[31:0]
addSignal -h 15 /tb_neuroedge_soc/dut/u_uart/wb_ack_o
