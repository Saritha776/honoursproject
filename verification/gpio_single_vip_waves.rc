; ==============================================================================
; Verdi nWave Signal Configuration File
; Project: NeuroEdge RISC-V SoC with Single GPIO VIP
; Target: UVM Simulation Waveform (tb_neuroedge_uvm_top)
; Database: verification/sim/neuroedge_uvm_sim.fsdb
; ==============================================================================

viewPort 0 28 1440 850 360 120

signalSpacing 5
windowTimeUnit 1ps

; Zoom to fit full simulation range up to completion milestone 0xAA
zoom 0.000000 3610000000.000000 1p
cursor 3593070000.000000
marker 3593070000.000000

curSTATUS ByChange

; ------------------------------------------------------------------------------
; Group 1: Single GPIO VIP Interface (u_gpio_if)
; ------------------------------------------------------------------------------
addGroup "1. GPIO VIP Interface"
addSignal -h 15 /tb_neuroedge_uvm_top/u_gpio_if/clk
addSignal -h 15 /tb_neuroedge_uvm_top/u_gpio_if/rst_n
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/u_gpio_if/gpio_in[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/u_gpio_if/gpio_out[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/u_gpio_if/gpio_dir[7:0]

; ------------------------------------------------------------------------------
; Group 2: DUT Top-Level GPIO Pins
; ------------------------------------------------------------------------------
addGroup "2. DUT GPIO Pins"
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/gpio_in[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/gpio_out[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/gpio_dir[7:0]

; ------------------------------------------------------------------------------
; Group 3: DUT GPIO Controller Internal Registers (u_gpio)
; ------------------------------------------------------------------------------
addGroup "3. GPIO Hardware Registers"
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/clk
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/rst_n
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/wb_adr_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/wb_dat_i[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/wb_dat_o[31:0]
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/wb_we_i
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/wb_stb_i
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/wb_cyc_i
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/wb_ack_o
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/sync_ff1[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/sync_ff2[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/reg_gpio_out[7:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/u_gpio/reg_gpio_dir[7:0]
addSignal -h 15 /tb_neuroedge_uvm_top/dut/u_gpio/gpio_irq

; ------------------------------------------------------------------------------
; Group 4: CPU Execution Trace (VeeR EL2 Autonomous Firmware)
; ------------------------------------------------------------------------------
addGroup "4. CPU Instruction Trace"
addSignal -h 15 /tb_neuroedge_uvm_top/dut/cpu_trace_valid_o
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/cpu_trace_pc_o[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_neuroedge_uvm_top/dut/cpu_trace_insn_o[31:0]
